# Aurora Backend Environment Variables

# ─── Required ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
CHROMA_HOST=http://localhost:8000
PORT=3001

# ─── Phase 2: Live Integrations ─────────────────
# OpenWeatherMap — free tier at https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key
# Serper.dev — web search at https://serper.dev
SERPER_API_KEY=your-serper-api-key

# ─── Phase 3: Google OAuth (Calendar + Gmail) ──
# Create at https://console.cloud.google.com/apis/credentials
# Enable: Google Calendar API + Gmail API
# Scopes: calendar.readonly, gmail.readonly
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/calendar/callback

# ─── Optional ───────────────────────────────────
JWT_SECRET=your-jwt-secret-here
EXPO_PUSH_TOKEN_SECRET=your-expo-push-token-secret
